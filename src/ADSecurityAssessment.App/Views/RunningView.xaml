<UserControl x:Class="ADSecurityAssessment.App.Views.RunningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ADSecurityAssessment.App.Views">
    <Grid Margin="32">
        <Border Style="{StaticResource Card}" MaxWidth="900" VerticalAlignment="Center" Padding="28">
            <StackPanel>
                <TextBlock Text="Assessment in progress" Style="{StaticResource TitleText}" FontSize="22"/>
                <TextBlock Text="{Binding ProgressMessage}" Style="{StaticResource BodyText}" Margin="0,10,0,16" AutomationProperties.LiveSetting="Polite"/>

                <Grid Height="8">
                    <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="6"
                                 Visibility="{Binding IsIndeterminate, Converter={StaticResource BoolToCollapsed}}"/>
                    <ProgressBar IsIndeterminate="True" Height="6"
                                 Visibility="{Binding IsIndeterminate, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <TextBlock Text="Read-only collection. Nothing is modified in Active Directory." Style="{StaticResource MutedText}" Margin="0,12,0,0"/>

                <Border Style="{StaticResource TableFrame}" Margin="0,20,0,0" Height="240">
                    <ListBox ItemsSource="{Binding LogLines}" Background="Transparent" BorderThickness="0" FontFamily="{StaticResource MonoFont}" FontSize="12"
                             Foreground="{DynamicResource MutedBrush}" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             views:LogAutoScroll.Enabled="True"/>
                </Border>

                <Button Style="{StaticResource SecondaryButton}" Margin="0,20,0,0" HorizontalAlignment="Left"
                        Content="Cancel" Command="{Binding CancelCommand}" AutomationProperties.Name="Cancel assessment"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
