<Window x:Class="ADSecurityAssessment.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ADSecurityAssessment.App.Views"
        Title="{Binding WindowTitle}"
        Width="1380" Height="880" MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource ShieldGeometry}" Width="26" Height="26" Stretch="Uniform" Fill="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="AD Security Assessment" FontSize="16" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <Border Style="{StaticResource Badge}" Background="{DynamicResource AccentSoftBrush}" Margin="14,0,0,0">
                        <TextBlock Text="READ-ONLY" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding RulesInfo}" Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Padding="12,6" Command="{Binding ToggleThemeCommand}"
                        Content="{Binding ThemeLabel}" AutomationProperties.Name="Toggle light and dark mode"/>
            </Grid>
        </Border>

        <!-- Faixa DEMO DATA: sempre visível enquanto os resultados exibidos forem fictícios -->
        <Border Grid.Row="1" Background="{DynamicResource BannerBrush}" Padding="20,8" Visibility="{Binding IsDemo, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding DemoBanner}" Foreground="{DynamicResource BannerTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>

        <!-- Conteúdo -->
        <Grid Grid.Row="2">
            <views:StartView Visibility="{Binding IsStart, Converter={StaticResource BoolToVis}}"/>
            <views:RunningView Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
            <views:ResultsView Visibility="{Binding IsResults, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <!-- Rodapé -->
        <Border Grid.Row="3" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding PrivacyStatement}" Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                <TextBlock Grid.Column="1" Text="{Binding ExportStatus}" Style="{StaticResource MutedText}" FontSize="12" Margin="16,0,0,0"
                           Visibility="{Binding HasExportStatus, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
