<UserControl x:Class="ADSecurityAssessment.App.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ADSecurityAssessment.App.Views">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navegação -->
        <Border Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Padding="12,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <Button Style="{StaticResource NavButton}" Content="Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Tag="{Binding IsDashboardPage}"/>
                    <Button Style="{StaticResource NavButton}" Content="Findings" Command="{Binding NavigateCommand}" CommandParameter="Findings" Tag="{Binding IsFindingsPage}"/>
                    <Button Style="{StaticResource NavButton}" Content="Assessment coverage" Command="{Binding NavigateCommand}" CommandParameter="Coverage" Tag="{Binding IsCoveragePage}"/>
                    <Button Style="{StaticResource NavButton}" Content="Environment" Command="{Binding NavigateCommand}" CommandParameter="Environment" Tag="{Binding IsEnvironmentPage}"/>
                    <Button Style="{StaticResource NavButton}" Content="Activity log" Command="{Binding NavigateCommand}" CommandParameter="Log" Tag="{Binding IsLogPage}"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="EXPORT REPORT" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="14,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Padding="0,7" Content="HTML" Command="{Binding ExportCommand}" CommandParameter="HTML"/>
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Padding="0,7" Content="JSON" Command="{Binding ExportCommand}" CommandParameter="JSON"/>
                        <Button Grid.Column="4" Style="{StaticResource SecondaryButton}" Padding="0,7" Content="CSV" Command="{Binding ExportCommand}" CommandParameter="CSV"/>
                    </Grid>
                    <Button Style="{StaticResource AccentButton}" Padding="0,8" Margin="0,8,0,0" Content="Export all formats" Command="{Binding ExportCommand}" CommandParameter="ALL"/>
                    <Button Style="{StaticResource SecondaryButton}" Padding="0,7" Margin="0,8,0,0" Content="Open reports folder" Command="{Binding OpenReportsFolderCommand}"/>
                    <Button Style="{StaticResource SecondaryButton}" Padding="0,7" Margin="0,18,0,0" Content="New assessment" Command="{Binding NewAssessmentCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Páginas -->
        <Grid Grid.Column="1">
            <Grid Visibility="{Binding IsDashboardPage, Converter={StaticResource BoolToVis}}">
                <views:DashboardView DataContext="{Binding Dashboard}"/>
            </Grid>
            <Grid Visibility="{Binding IsFindingsPage, Converter={StaticResource BoolToVis}}">
                <views:FindingsView DataContext="{Binding Findings}"/>
            </Grid>
            <Grid Visibility="{Binding IsCoveragePage, Converter={StaticResource BoolToVis}}">
                <views:CoverageView DataContext="{Binding Coverage}"/>
            </Grid>
            <Grid Visibility="{Binding IsEnvironmentPage, Converter={StaticResource BoolToVis}}">
                <views:EnvironmentView DataContext="{Binding Environment}"/>
            </Grid>
            <Grid Visibility="{Binding IsLogPage, Converter={StaticResource BoolToVis}}">
                <views:LogView/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
