<UserControl x:Class="ADSecurityAssessment.App.Views.CoverageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ADSecurityAssessment.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" views:ScrollForwarding.Enabled="True">
        <StackPanel Margin="28,24,28,28">
            <TextBlock Text="Assessment coverage" Style="{StaticResource TitleText}"/>
            <TextBlock Text="{Binding Explanation}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>

            <!-- Categorias -->
            <TextBlock Text="Coverage by category" Style="{StaticResource SectionText}" Margin="0,22,0,8"/>
            <Border Style="{StaticResource TableFrame}">
                <StackPanel>
                    <Border Style="{StaticResource TableHeadRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Category" Style="{StaticResource TableHead}"/>
                            <TextBlock Grid.Column="1" Text="Status" Style="{StaticResource TableHead}"/>
                            <TextBlock Grid.Column="2" Text="Passed" Style="{StaticResource TableHead}"/>
                            <TextBlock Grid.Column="3" Text="Failed" Style="{StaticResource TableHead}"/>
                            <TextBlock Grid.Column="4" Text="Not evaluated" Style="{StaticResource TableHead}"/>
                            <TextBlock Grid.Column="5" Text="N/A" Style="{StaticResource TableHead}"/>
                            <TextBlock Grid.Column="6" Text="Coverage" Style="{StaticResource TableHead}"/>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TableRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Category}" Style="{StaticResource TableCell}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource TableCellMuted}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Passed}" Style="{StaticResource TableCell}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Failed}" Style="{StaticResource TableCell}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding NotEvaluated}" Style="{StaticResource TableCell}"/>
                                        <TextBlock Grid.Column="5" Text="{Binding NotApplicable}" Style="{StaticResource TableCell}"/>
                                        <StackPanel Grid.Column="6" Margin="10,9,10,6">
                                            <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding Fraction, Mode=OneWay}"/>
                                            <TextBlock Text="{Binding Coverage}" FontSize="12" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Regras não avaliadas -->
            <TextBlock Text="Rules not evaluated or not applicable" Style="{StaticResource SectionText}" Margin="0,24,0,8"/>
            <Border Style="{StaticResource TableFrame}">
                <StackPanel>
                    <Border Style="{StaticResource TableHeadRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Rule" Style="{StaticResource TableHead}"/>
                            <TextBlock Grid.Column="1" Text="Title" Style="{StaticResource TableHead}"/>
                            <TextBlock Grid.Column="2" Text="Outcome" Style="{StaticResource TableHead}"/>
                            <TextBlock Grid.Column="3" Text="Reason" Style="{StaticResource TableHead}"/>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding NotEvaluated}" MaxHeight="360">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" CanContentScroll="True"><ItemsPresenter/></ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TableRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="3*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding RuleId}" Style="{StaticResource TableCellMuted}" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource TableCell}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Outcome}" Style="{StaticResource TableCell}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Reason}" Style="{StaticResource TableCellMuted}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Datasets -->
            <TextBlock Text="Collected datasets" Style="{StaticResource SectionText}" Margin="0,24,0,8"/>
            <Border Style="{StaticResource TableFrame}">
                <StackPanel>
                    <Border Style="{StaticResource TableHeadRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Dataset" Style="{StaticResource TableHead}"/>
                            <TextBlock Grid.Column="1" Text="Coverage" Style="{StaticResource TableHead}"/>
                            <TextBlock Grid.Column="2" Text="Collector" Style="{StaticResource TableHead}"/>
                            <TextBlock Grid.Column="3" Text="Reason" Style="{StaticResource TableHead}"/>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Datasets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TableRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="3*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource TableCell}" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Coverage}" Style="{StaticResource TableCell}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Collector}" Style="{StaticResource TableCellMuted}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Reason}" Style="{StaticResource TableCellMuted}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Collectors -->
            <TextBlock Text="Collectors" Style="{StaticResource SectionText}" Margin="0,24,0,8"/>
            <Border Style="{StaticResource TableFrame}">
                <StackPanel>
                    <Border Style="{StaticResource TableHeadRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Collector" Style="{StaticResource TableHead}"/>
                            <TextBlock Grid.Column="1" Text="Status" Style="{StaticResource TableHead}"/>
                            <TextBlock Grid.Column="2" Text="Objects" Style="{StaticResource TableHead}"/>
                            <TextBlock Grid.Column="3" Text="Seconds" Style="{StaticResource TableHead}"/>
                            <TextBlock Grid.Column="4" Text="Errors and warnings" Style="{StaticResource TableHead}"/>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Collectors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TableRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="3*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource TableCell}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource TableCell}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Objects}" Style="{StaticResource TableCellMuted}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Seconds}" Style="{StaticResource TableCellMuted}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Notes}" Style="{StaticResource TableCellMuted}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
