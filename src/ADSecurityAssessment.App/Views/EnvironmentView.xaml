<UserControl x:Class="ADSecurityAssessment.App.Views.EnvironmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ADSecurityAssessment.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" views:ScrollForwarding.Enabled="True">
        <StackPanel Margin="28,24,28,28">
            <TextBlock Text="Environment summary" Style="{StaticResource TitleText}"/>

            <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="8">
                <ItemsControl ItemsSource="{Binding Facts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource TableRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource TableCellMuted}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource TableCell}" FontWeight="SemiBold"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Text="Domains" Style="{StaticResource SectionText}" Margin="0,24,0,8"/>
            <Border Style="{StaticResource TableFrame}">
                <StackPanel>
                    <Border Style="{StaticResource TableHeadRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Domain" Style="{StaticResource TableHead}"/>
                            <TextBlock Grid.Column="1" Text="NetBIOS" Style="{StaticResource TableHead}"/>
                            <TextBlock Grid.Column="2" Text="Functional level" Style="{StaticResource TableHead}"/>
                            <TextBlock Grid.Column="3" Text="DCs" Style="{StaticResource TableHead}"/>
                            <TextBlock Grid.Column="4" Text="Users (enabled/total)" Style="{StaticResource TableHead}"/>
                            <TextBlock Grid.Column="5" Text="Computers" Style="{StaticResource TableHead}"/>
                            <TextBlock Grid.Column="6" Text="PDC emulator" Style="{StaticResource TableHead}"/>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Domains}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TableRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="2*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource TableCell}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding NetBios}" Style="{StaticResource TableCellMuted}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Level}" Style="{StaticResource TableCellMuted}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding DomainControllers}" Style="{StaticResource TableCell}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Users}" Style="{StaticResource TableCell}"/>
                                        <TextBlock Grid.Column="5" Text="{Binding Computers}" Style="{StaticResource TableCell}"/>
                                        <TextBlock Grid.Column="6" Text="{Binding Pdc}" Style="{StaticResource TableCellMuted}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="FSMO roles" Style="{StaticResource SectionText}"/>
                    <Border Style="{StaticResource Card}" Padding="14,10">
                        <ItemsControl ItemsSource="{Binding Fsmo}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource BodyText}" Margin="0,3"/></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Domain controller operating systems" Style="{StaticResource SectionText}"/>
                    <Border Style="{StaticResource Card}" Padding="14,10">
                        <ItemsControl ItemsSource="{Binding OperatingSystems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource BodyText}" Margin="0,3"/></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
