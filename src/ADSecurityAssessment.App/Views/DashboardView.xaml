<UserControl x:Class="ADSecurityAssessment.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ADSecurityAssessment.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,28">

            <TextBlock Text="Security overview" Style="{StaticResource TitleText}"/>

            <!-- Score geral + severidades -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Overall Security Score" Style="{StaticResource SectionText}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="120" Height="120" VerticalAlignment="Top">
                                <Ellipse Margin="3" Stroke="{DynamicResource TrackBrush}" StrokeThickness="10"/>
                                <Path Data="{Binding ScoreValue, Converter={StaticResource ScoreArc}}" Stroke="{Binding Tone, Converter={StaticResource ToneBrush}}"
                                      StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding ScoreText}" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="out of 100" FontSize="11" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                <Border Style="{StaticResource Badge}" Background="{Binding Tone, Converter={StaticResource ToneBrush}}">
                                    <TextBlock Text="{Binding Rating}" Foreground="White" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock Text="{Binding RiskText}" Style="{StaticResource BodyText}" Margin="0,10,0,0"/>
                                <TextBlock Text="{Binding CoverageText}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                        <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding CoverageFraction, Mode=OneWay}" Margin="0,16,0,0"
                                     AutomationProperties.Name="Assessment coverage"/>
                        <TextBlock Text="{Binding ProvisionalReason}" Style="{StaticResource MutedText}" Margin="0,10,0,0" FontWeight="SemiBold"
                                   Visibility="{Binding IsProvisional, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding CapNote}" Style="{StaticResource MutedText}" Margin="0,6,0,0"
                                   Visibility="{Binding CapNote, Converter={StaticResource NullToVis}}"/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0" FontSize="12"
                                   Text="The score measures risk found in what was evaluated. Coverage is reported separately and un-evaluated areas never raise the score."/>
                    </StackPanel>
                </Border>

                <ItemsControl Grid.Column="2" ItemsSource="{Binding Severities}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="2" Columns="2"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CardButton}" Command="{Binding Filter}" Margin="0,0,12,12" Padding="20,16"
                                    AutomationProperties.Name="{Binding Name}">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Count}" FontSize="36" FontWeight="SemiBold" Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}"/>
                                        <TextBlock Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold">
                                            <Run Text="{Binding Name, Mode=OneWay}"/><Run Text=" findings"/>
                                        </TextBlock>
                                        <TextBlock Text="Click to filter" FontSize="11" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- Score por categoria -->
            <TextBlock Text="Score by category" Style="{StaticResource SectionText}" Margin="0,12,0,10"/>
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource CardButton}" Command="{Binding Filter}" Width="274" Margin="0,0,14,14" Padding="18,14"
                                AutomationProperties.Name="{Binding Name}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" Style="{StaticResource MutedText}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding ScoreText}" FontSize="28" FontWeight="SemiBold" Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}"/>
                                </Grid>
                                <TextBlock Text="{Binding Rating}" FontSize="12" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                                <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding CoverageFraction, Mode=OneWay}" Margin="0,10,0,0"/>
                                <TextBlock Text="{Binding CoverageText}" FontSize="12" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Counts}" FontSize="12" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Prioridades -->
            <TextBlock Text="Top priorities" Style="{StaticResource SectionText}" Margin="0,10,0,10"/>
            <TextBlock Text="{Binding NoFindingsNote}" Style="{StaticResource MutedText}" Visibility="{Binding NoFindingsNote, Converter={StaticResource NullToVis}}"/>
            <ItemsControl ItemsSource="{Binding Priorities}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource CardButton}" Command="{Binding Open}" Margin="0,0,0,8" Padding="16,12" AutomationProperties.Name="{Binding Title}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Badge}" Background="{Binding SeverityName, Converter={StaticResource SeverityBrush}}">
                                    <TextBlock Text="{Binding SeverityName}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding RuleId}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Run Text="{Binding Affected, Mode=OneWay}"/><Run Text=" affected"/>
                                </TextBlock>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
