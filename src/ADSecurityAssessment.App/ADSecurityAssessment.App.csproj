<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(AdsTfm)-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>ADSecurityAssessment</AssemblyName>
    <RootNamespace>ADSecurityAssessment.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>AD Security Assessment</Product>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Publicação com RuntimeIdentifier = UM único .exe auto-contido (runtime .NET + WPF + regras + modelo do relatório embutidos). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ADSecurityAssessment.Core\ADSecurityAssessment.Core.csproj" />
    <ProjectReference Include="..\ADSecurityAssessment.Rules\ADSecurityAssessment.Rules.csproj" />
    <ProjectReference Include="..\ADSecurityAssessment.Collectors\ADSecurityAssessment.Collectors.csproj" />
    <ProjectReference Include="..\ADSecurityAssessment.Infrastructure\ADSecurityAssessment.Infrastructure.csproj" />
    <ProjectReference Include="..\ADSecurityAssessment.Reporting\ADSecurityAssessment.Reporting.csproj" />
  </ItemGroup>

  <!-- Build normal: config/rules/templates/data são copiadas para ao lado do executável. No publish single-file elas NÃO são copiadas (já estão embutidas); config/, reports/, logs/ e data/ são criadas ao lado do .exe na primeira execução. -->
  <ItemGroup Condition="'$(PublishSingleFile)' != 'true'">
    <Content Include="..\..\config\**\*.*" Link="config\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\rules\**\*.*" Link="rules\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\templates\**\*.*" Link="templates\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\data\**\*.*" Link="data\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
