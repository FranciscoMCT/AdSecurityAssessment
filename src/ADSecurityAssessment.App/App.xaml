<Application x:Class="ADSecurityAssessment.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ADSecurityAssessment.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- O ThemeService troca Light.xaml ↔ Dark.xaml em tempo de execução. -->
                <ResourceDictionary Source="Themes/Light.xaml"/>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToCollapsed" Invert="True"/>
            <conv:NullToVisibilityConverter x:Key="NullToVis"/>
            <conv:NullToVisibilityConverter x:Key="NullToCollapsed" Invert="True"/>
            <conv:SeverityBrushConverter x:Key="SeverityBrush"/>
            <conv:ToneBrushConverter x:Key="ToneBrush"/>
            <conv:ScoreArcConverter x:Key="ScoreArc"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
