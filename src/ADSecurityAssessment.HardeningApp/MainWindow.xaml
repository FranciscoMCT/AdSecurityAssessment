<Window x:Class="ADSecurityAssessment.HardeningApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AD Security Hardening — GPOs de baseline (criadas SEM vínculo)"
        Height="780" Width="1200" MinHeight="560" MinWidth="920"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <DockPanel LastChildFill="True" Margin="0,0,0,6">
                <Button x:Name="BtnConnect" DockPanel.Dock="Right" Content="Conectar ao domínio" Padding="14,4" Click="OnConnect"/>
                <TextBlock DockPanel.Dock="Left" Text="Controlador de domínio (opcional):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtServer" Margin="0,0,8,0" Padding="4,3"
                         ToolTip="Vazio = PDC emulator do domínio do usuário atual."/>
            </DockPanel>
            <TextBlock x:Name="TxtStatus" TextWrapping="Wrap" Text="Não conectado. A prévia funciona offline; para criar GPOs é preciso conectar."/>
        </StackPanel>

        <TabControl Grid.Row="1">
            <!-- ================= PLANO ================= -->
            <TabItem Header="1. Plano">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Escopos (uma GPO por escopo)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <WrapPanel x:Name="PnlProfiles"/>
                    </StackPanel>
                    <ListView x:Name="LstSettings" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnSettingSelected">
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Margin="0,8,0,2"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Aplicar" Width="60">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Configuração" Width="520" DisplayMemberBinding="{Binding Title}"/>
                                <GridViewColumn Header="Categoria" Width="210" DisplayMemberBinding="{Binding Category}"/>
                                <GridViewColumn Header="Risco" Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding RiskLabel}" Foreground="{Binding RiskBrush}" FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Fica gravada?" Width="100" DisplayMemberBinding="{Binding TattooLabel}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,6">
                        <Button Content="Marcar padrão recomendado" Padding="10,3" Margin="0,0,8,0" Click="OnResetDefaults"/>
                        <Button Content="Verificar tabela de auditoria nesta máquina (auditpol)" Padding="10,3" Click="OnCheckAuditTable"/>
                    </StackPanel>
                    <TextBox x:Name="TxtDetails" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Padding="6" Text="Selecione uma configuração para ver o porquê, o impacto e os pré-requisitos."/>
                </Grid>
            </TabItem>

            <!-- ================= SENHA / LOCKOUT ================= -->
            <TabItem Header="2. Senha e bloqueio do domínio">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="A política de senha e de bloqueio de conta do domínio só vale pela Default Domain Policy ou por um PSO (Fine-Grained Password Policy). Uma GPO em OU não a altera para contas de domínio. Por isso esta ferramenta apenas COMPARA os valores atuais com as referências da Microsoft e orienta; ela não altera a Default Domain Policy."/>
                    <ListView x:Name="LstPolicy" Grid.Row="1">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Item" Width="260" DisplayMemberBinding="{Binding Label}"/>
                                <GridViewColumn Header="Atual" Width="170" DisplayMemberBinding="{Binding Current}"/>
                                <GridViewColumn Header="Referência" Width="190" DisplayMemberBinding="{Binding Recommended}"/>
                                <GridViewColumn Header="Situação" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Observação" Width="380" DisplayMemberBinding="{Binding Note}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock x:Name="TxtPsos" Grid.Row="2" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>

            <!-- ================= PRÉVIA E CRIAÇÃO ================= -->
            <TabItem Header="3. Prévia e criação">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="As GPOs são criadas SEM vínculo: nenhum computador é afetado até que você as vincule a uma OU piloto no GPMC. A ferramenta nunca vincula, nunca altera GPO existente e só remove GPOs que ela mesma criou."/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox x:Name="ChkRollback" Content="Gerar também as GPOs [ROLLBACK] (reversão)" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <ComboBox x:Name="CmbExisting" Width="330" SelectedIndex="0">
                            <ComboBoxItem Content="Se a GPO já existir: ignorar (recomendado)"/>
                            <ComboBoxItem Content="Se a GPO já existir: criar nova revisão"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="BtnPreview" Content="Gerar prévia (relatório HTML + JSON)" Padding="14,6" Margin="0,0,10,0" Click="OnPreview"/>
                        <Button x:Name="BtnCreate" Content="Criar GPOs no domínio (sem vínculo)" Padding="14,6" Click="OnCreate" IsEnabled="False"/>
                    </StackPanel>
                    <TextBox x:Name="TxtOutput" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" Padding="6"/>
                </Grid>
            </TabItem>

            <!-- ================= GPOs CRIADAS ================= -->
            <TabItem Header="4. GPOs criadas por esta ferramenta">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Atualizar" Padding="12,4" Margin="0,0,8,0" Click="OnRefreshLedger"/>
                        <Button x:Name="BtnRemove" Content="Remover selecionada" Padding="12,4" Margin="0,0,8,0" Click="OnRemove" IsEnabled="False"/>
                        <Button Content="Abrir pasta de relatórios" Padding="12,4" Click="OnOpenReports"/>
                    </StackPanel>
                    <ListView x:Name="LstLedger" Grid.Row="1" SelectionMode="Single">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Nome" Width="420" DisplayMemberBinding="{Binding DisplayName}"/>
                                <GridViewColumn Header="GUID" Width="290" DisplayMemberBinding="{Binding IdText}"/>
                                <GridViewColumn Header="Escopo" Width="110" DisplayMemberBinding="{Binding Profile}"/>
                                <GridViewColumn Header="Tipo" Width="90" DisplayMemberBinding="{Binding Kind}"/>
                                <GridViewColumn Header="Criada em" Width="150" DisplayMemberBinding="{Binding CreatedText}"/>
                                <GridViewColumn Header="Por" Width="200" DisplayMemberBinding="{Binding CreatedBy}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <!-- ================= LOG ================= -->
            <TabItem Header="Log">
                <TextBox x:Name="TxtLog" Margin="8" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="Gray"
                   Text="Para criar GPOs execute com uma conta com permissão no domínio (Domain Admins ou Group Policy Creator Owners). Não é preciso ser administrador local nem instalar RSAT. Itens de alto risco vêm desmarcados; leia os pré-requisitos antes de marcá-los."/>
    </Grid>
</Window>
